server.port=9090
spring.application.name=demo

# MongoDB - application.properties
spring.data.mongodb.uri=mongodb://localhost:27017/mdm_db

#APNs
apns.key-path=src/main/java/com/example/demo/keys/key_example
apns.key-id=yourkey
apns.team-id=yourteam
apns.bundle-id=yourbundle
apns.sandbox=true

#Mail
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=yourmail
spring.mail.password=yourpassword
report.mail.to=yourreceiver